#!/bin/bash
set -e

CURRENT_USER=$(stat -f%Su /dev/console)
USER_HOME=$(eval echo "~$CURRENT_USER")
PLIST="$USER_HOME/Library/LaunchAgents/com.vasyl.whisper-dictation-vp.plist"

as_user() { sudo -u "$CURRENT_USER" "$@"; }

# Idioma del usuario de la sesión (es → español; cualquier otro → inglés)
USER_LANG=$(as_user defaults read -g AppleLocale 2>/dev/null | cut -c1-2)
[ "$USER_LANG" = "es" ] || USER_LANG="en"

dialog_ok() {
  # $1=mensaje $2=titulo $3=icono
  OK_BTN="Entendido"; [ "$USER_LANG" = "en" ] && OK_BTN="Got it"
  as_user osascript -e "tell application \"System Events\"
    activate
    display dialog \"$1\" with title \"$2\" buttons {\"$OK_BTN\"} default button 1 with icon $3
  end tell" 2>/dev/null || true
}

# ── 1. Cerrar instancias en ejecución y limpiar instalaciones antiguas ───────
pkill -f "whisper_dictation_vp.py" 2>/dev/null || true
pkill -f "Whisper Dictation VP.app/Contents/MacOS" 2>/dev/null || true
rm -rf /usr/local/lib/whisper_dictation_vp 2>/dev/null || true
sleep 1

# ── 1b. Resetear el permiso de Accesibilidad si la firma es ad-hoc ───────────
# Con firma ad-hoc, cada build tiene identidad distinta y el permiso de la
# versión anterior queda "huérfano": la casilla aparece activada pero macOS
# ignora al binario nuevo (la tecla no responde y el aviso sale en cada
# arranque). Al resetear, macOS pide el permiso UNA vez, limpio, y funciona.
# Con firma estable (certificado local) el permiso se conserva y NO se resetea.
if codesign -dv "/Applications/Whisper Dictation VP.app" 2>&1 | grep -q "adhoc"; then
  tccutil reset Accessibility com.vasyl.whisper-dictation-vp 2>/dev/null || true
fi

# ── 2. Crear LaunchAgent (auto-inicio al login) ──────────────────────────────
mkdir -p "$USER_HOME/Library/LaunchAgents"
cat > "$PLIST" << PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vasyl.whisper-dictation-vp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>sleep 10 &amp;&amp; open -a "Whisper Dictation VP"</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
PLISTEOF
chown "$CURRENT_USER" "$PLIST"

# ── 3. Activar LaunchAgent ───────────────────────────────────────────────────
as_user launchctl unload "$PLIST" 2>/dev/null || true
as_user launchctl load "$PLIST" 2>/dev/null || true

# ── 4. Instrucciones de Accesibilidad (bilingüe) ─────────────────────────────
if [ "$USER_LANG" = "es" ]; then
dialog_ok \
"✅ Whisper Dictation VP 3.5.3 instalada correctamente.

ÚLTIMO PASO — al abrirse la app, macOS pedirá el permiso de Accesibilidad:

1. Pulsa «Abrir Ajustes del Sistema» en el aviso
2. Activa la casilla «Whisper Dictation VP»
3. Sal de la app (icono 🎙 → Salir) y vuelve a abrirla

Este paso se pide en cada actualización porque la firma de la app cambia; es normal y solo hay que hacerlo una vez por versión." \
"Whisper Dictation VP instalada" "note"
else
dialog_ok \
"✅ Whisper Dictation VP 3.5.3 installed successfully.

LAST STEP — when the app opens, macOS will ask for the Accessibility permission:

1. Click 'Open System Settings' in the prompt
2. Enable the 'Whisper Dictation VP' checkbox
3. Quit the app (🎙 icon → Quit) and open it again

This step is required after each update because the app's signature changes; it's normal and only needed once per version." \
"Whisper Dictation VP installed" "note"
fi

# ── 5. Lanzar la app al finalizar ────────────────────────────────────────────
as_user open -a "Whisper Dictation VP" 2>/dev/null || true

exit 0
