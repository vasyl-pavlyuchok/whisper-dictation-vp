#!/bin/bash
set -e

CURRENT_USER=$(stat -f%Su /dev/console)
USER_HOME=$(eval echo "~$CURRENT_USER")
PLIST="$USER_HOME/Library/LaunchAgents/com.vasyl.whisper-dictation-vp.plist"

as_user() { sudo -u "$CURRENT_USER" "$@"; }

dialog_ok() {
  # $1=mensaje $2=titulo $3=icono
  as_user osascript -e "tell application \"System Events\"
    activate
    display dialog \"$1\" with title \"$2\" buttons {\"Entendido\"} default button 1 with icon $3
  end tell" 2>/dev/null || true
}

# ── 1. Limpiar instalaciones antiguas (v2.x usaba Python del sistema) ────────
pkill -f "whisper_dictation_vp.py" 2>/dev/null || true
rm -rf /usr/local/lib/whisper_dictation_vp 2>/dev/null || true

# ── 2. Crear LaunchAgent (auto-inicio al login) ──────────────────────────────
mkdir -p "$USER_HOME/Library/LaunchAgents"
cat > "$PLIST" << PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vasyl.whisper-dictation-vp</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>sleep 10 &amp;&amp; open -a "Whisper Dictation VP"</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
PLISTEOF
chown "$CURRENT_USER" "$PLIST"

# ── 3. Activar LaunchAgent ───────────────────────────────────────────────────
as_user launchctl unload "$PLIST" 2>/dev/null || true
as_user launchctl load "$PLIST" 2>/dev/null || true

# ── 4. Instrucciones de Accesibilidad ────────────────────────────────────────
dialog_ok \
"✅ Whisper Dictation VP 3.0.0 instalado correctamente.

Ahora es una app 100% nativa: ya no necesita Python ni ninguna ventana de Terminal.

PASO OBLIGATORIO — Permiso de Accesibilidad:

Al abrir la app, macOS te pedirá el permiso automáticamente. Si no aparece:

1. Abre: Ajustes del Sistema → Privacidad y seguridad → Accesibilidad

2. Activa la casilla de «Whisper Dictation VP»

3. Sal de la app (icono 🎙 → Salir) y vuelve a abrirla

Si venías de una versión anterior, puedes desmarcar «Terminal» de esa lista: ya no hace falta.

Tecla predeterminada: Option derecho
(doble-toque para iniciar, toque simple para detener)" \
"Whisper Dictation VP instalado" "note"

# ── 5. Lanzar la app al finalizar ────────────────────────────────────────────
as_user open -a "Whisper Dictation VP" 2>/dev/null || true

exit 0
